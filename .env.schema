# The plugin version is pinned so the schema resolves through `bunx varlock`
# before node_modules exists (cloud-agent and fresh-clone installs).
# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(id=development, token=fallback($CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN, $CI_OP_TOKEN), allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @initOp(id=production, token=$DEPLOY_AGENT_PRODUCTION_OP_TOKEN, allowAppAuth=false)
# @initOp(id=release, token=$RELEASE_AGENT_TOOLING_OP_TOKEN, allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @currentEnv=$VARLOCK_ENV
# Lifecycles: production and development resolve through 1Password; test
# resolves to fake-but-shaped literals only, so schema validation and the Bun
# test suites run fully offline with no 1Password access. Every lifecycle
# resolves deliberately — add a test arm whenever you add a variable.
# Sensitivity fails safe: an item without an explicit marker resolves as
# sensitive, so a forgotten decorator becomes a container secret rather than a
# plaintext value baked into the website bundle. Public values must opt out
# explicitly.
# @defaultSensitive=true @defaultRequired=infer
# ---

# Varlock's selector. The enum is the fail-loud guard: any other value —
# including lifecycles varlock can infer in CI, like preview — is rejected at
# load instead of silently riding each value's development arm.
# @public @auditIgnore @type=enum(development, production, test)
VARLOCK_ENV=development


# --- Bootstrap identities ------------------------------------------------
# One per unattended consumer; the name encodes the consumer and lifecycle it
# serves. Supervised local work uses 1Password desktop-app authorization
# instead. Both are @internal, so `varlock run` never exports them into the
# api, worker, or web containers.

# Production deploy-agent role slot: each deploy venue supplies its own
# identity under this one name — the self-hosted GitHub Actions runner on the
# Mac mini injects the GitHub deploy agent's token
# (GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN secret), and an operator run resolves
# the Mac Mini identity through `op run` in the deploy script.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @required=forEnv(production)
DEPLOY_AGENT_PRODUCTION_OP_TOKEN=

# Shared cloud-agent development identity, read-only on the Development vault:
# a Cursor account-scoped Runtime Secret and an environment variable on the
# Claude cloud environment. Supervised local development leaves this empty and
# uses desktop-app authorization.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN=

# CI bootstrap role slot. Quality and the deploy job supply the GitHub deploy
# identity here to resolve install credentials from the Development vault.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CI_OP_TOKEN=

# Release-agent role slot, read-only on the Tooling vault. The publish job
# injects GH_RELEASE_AGENT_TOOLING_OP_TOKEN. A local release leaves this empty
# and uses desktop-app authorization on the release client.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
RELEASE_AGENT_TOOLING_OP_TOKEN=


# --- Context switches ----------------------------------------------------
# Machinery credentials resolve ONLY behind these switches. Build, dev-server,
# test, and ordinary production resolution therefore never contact 1Password —
# which matters because Vite and the Docker build re-resolve the whole schema
# in contexts that cannot authenticate.

# Set to true by the install paths (cloud agent install script, CI install step,
# deploy script) when fetching install tokens with `varlock printenv`.
# @public @internal @auditIgnore @type=boolean
TMTERMINAL_RESOLVE_INSTALL_TOKENS=false

# Set to true by the npm release flow when fetching the publish token. Release
# is a separate context from install: it targets the Tooling lifecycle vault
# and runs only from an operator release session.
# @public @internal @auditIgnore @type=boolean
TMTERMINAL_RESOLVE_RELEASE_TOKENS=false


# --- Machinery credentials -----------------------------------------------

# Installing the private @merchbaseco/* packages. Shared suite credential: the
# name identifies the issuing owner, not this repo, and it resolves from the
# existing shared item rather than a per-repo copy. Referenced literally by
# .npmrc.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_GITHUB_NPM_TOKEN=if(eq($TMTERMINAL_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/GitHub Packages Read - Merchbase/credential"), "")

# Licensed @hugeicons-pro dist downloads. Shared suite credential — the same
# vendor licence serves BidBeacon, MerchBase Core, Handmade, TMTerminal, and
# PunchPress — so it resolves from one shared item under the owner prefix.
# Referenced literally by bunfig.toml's [install.scopes] token.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_HUGEICONS_LICENSE_KEY=if(eq($TMTERMINAL_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HugeIcons Pro - Merchbase/credential"), "")

# Publishing @tmterminal/cli and @tmterminal/http-client to the public npm
# registry. Shared suite credential — one publish token for every Merchbase
# package — gated by this repo's release switch.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_NPM_PUBLISH_TOKEN=if(eq($TMTERMINAL_RESOLVE_RELEASE_TOKENS, true), op(release, "op://Tooling/NPM Publish - Merchbase/credential"), "")


# --- Cloudflare Access ---------------------------------------------------
# Production validates signed origin assertions. Local development uses the
# explicit shared principal only with development runtime and local storage.

# @public @type=url
MERCHBASE_ACCESS_AUTHORITY_ORIGIN=https://access-internal.merchbase.co

# @public @required=forEnv(production) @type=url
MERCHBASE_ACCESS_ISSUER=ifs(eq($VARLOCK_ENV, test), https://example.cloudflareaccess.com, eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/issuer"), undefined)

# @public @required=forEnv(production)
MERCHBASE_ACCESS_API_AUDIENCE=ifs(eq($VARLOCK_ENV, test), suite-api-test, eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/API audience"), undefined)

# @public @required=forEnv(production)
MERCHBASE_ACCESS_INTERACTIVE_AUDIENCE=ifs(eq($VARLOCK_ENV, test), interactive-test, eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/interactive audience"), undefined)

# @public @required=forEnv(production)
MERCHBASE_ACCESS_TMTERMINAL_INTERNAL_AUDIENCE=ifs(eq($VARLOCK_ENV, test), tm-internal-test, eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/Trademark Terminal internal audience"), undefined)

# @public @required=forEnv(production)
MERCHBASE_ACCESS_TMTERMINAL_CLIENT_ID=ifs(eq($VARLOCK_ENV, test), tmterminal.access, eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - Trademark Terminal/client id"), undefined)

# @sensitive @required=forEnv(production)
MERCHBASE_ACCESS_TMTERMINAL_CLIENT_SECRET=ifs(eq($VARLOCK_ENV, test), test-service-secret, eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - Trademark Terminal/client secret"), undefined)

# @public @required=forEnv(production)
MERCHBASE_ACCESS_AUTHORITY_CLIENT_ID=ifs(eq($VARLOCK_ENV, test), authority.access, eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - Merchbase Access/client id"), undefined)

# Development-only operator selection never reaches production.
# @sensitive @optional
TMTERMINAL_DEV_OPERATOR_MERCHBASE_USER_ID=if(eq($VARLOCK_ENV, test), mbu_test_operator, undefined)

# --- Server runtime configuration ----------------------------------------

# Interface the Fastify server binds. Containers bind every interface; a
# workstation binds loopback only. A venue reached through a port forwarder
# overrides it for that session — see TMTERMINAL_DEV_HOST for why.
# @public
TMTERMINAL_HOST=if(eq($VARLOCK_ENV, production), 0.0.0.0, 127.0.0.1)

# Interface the Vite development server binds, and a development-only concern:
# `apps/web/vite.config.ts` is the only reader. Loopback keeps a dev server —
# and the synthetic data behind it — off the network. A venue that reaches the
# server through a port forwarder sets 0.0.0.0 for its own dev command, because
# such forwarders find a session's ports by watching for listening sockets and a
# loopback-only bind is invisible to them; the same venue widens TMTERMINAL_HOST
# for the API. Only the socket widens: development authorization still requires local storage.
# @public @type=ip
TMTERMINAL_DEV_HOST=127.0.0.1

# Port the Fastify server listens on inside its own runtime. A workstation dev
# run overrides it with a `dev-port` allocation.
# @public @type=port
TMTERMINAL_PORT=3000

# Loopback port the host publishes the API on. Production is fixed; a
# workstation Compose run overrides it with a `dev-port` allocation. Also the
# Vite dev server's /api proxy target.
# @public @type=port
TMTERMINAL_API_PORT=if(eq($VARLOCK_ENV, production), 3095, 3000)

# Loopback port the host publishes the website on; Cloudflare Tunnel fronts it
# in production.
# @public @type=port
TMTERMINAL_WEB_PORT=if(eq($VARLOCK_ENV, production), 8095, 5173)

# Remote MCP resource identifier published in the OAuth discovery metadata.
# Must be an absolute http(s) URL whose path is exactly /mcp.
# @public @type=url
TMTERMINAL_MCP_RESOURCE_URL=if(eq($VARLOCK_ENV, production), https://tmterminal-api.merchbase.co/mcp, http://127.0.0.1:3000/mcp)

# Container path of the worker's artifact volume. Declared so the mount in
# compose.yml and the path the worker writes to have one owner.
# @public
TMTERMINAL_ARTIFACT_STORE_ROOT=/var/lib/tmterminal/artifacts

# Git revision the deployed images are labelled and tagged with. Supplied by
# the deploy script (`scripts/deployment-revision`) or by `scripts/compose` for
# a workstation stack; never provisioned in a vault.
# @public @optional
TMTERMINAL_REVISION=


# --- Database ------------------------------------------------------------
# Production Compose reaches Postgres on the container network. Development
# and test are always loopback: `bun run dev` and Cloud Agents share one local
# seed model. The Production and Development vaults still share the
# `Postgres - TMTerminal` credential so a local cluster can be provisioned
# with the same role the server resolves. Workstation Compose sets
# TMTERMINAL_DATABASE_HOST=database in `scripts/compose` so API containers
# talk to the compose service, not their own loopback.

# @public
TMTERMINAL_DATABASE_HOST=if(eq($VARLOCK_ENV, production), database, 127.0.0.1)

# In-network port for production, the Mac mini's published loopback port for
# everyone else.
# @public @type=port
TMTERMINAL_DATABASE_PORT=if(eq($VARLOCK_ENV, production), 5432, 5437)

# Loopback port the host publishes PostgreSQL on. Keep it in step with
# TMTERMINAL_DATABASE_PORT's non-production arm.
# @public @type=port
TMTERMINAL_DATABASE_PUBLISHED_PORT=5437

# Legacy identifiers: the live database was created before the TMTurtle →
# Trademark Terminal rename and the role and database are still named
# `tmturtle`. Renaming them is a database migration, not an environment change.
# @public
TMTERMINAL_DATABASE_NAME=if(eq($VARLOCK_ENV, test), tmterminal_test, tmturtle)

# @public
TMTERMINAL_DATABASE_USER=if(eq($VARLOCK_ENV, test), tmterminal_test, tmturtle)

# @sensitive @required
TMTERMINAL_DATABASE_PASSWORD=if(eq($VARLOCK_ENV, test), tmterminal_test, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - TMTerminal/password"), op(development, "op://Development/Postgres - TMTerminal/password")))

# Composed from the parts above so the connection string has exactly one owner
# and a venue can override a single part.
# @sensitive @required
TMTERMINAL_DATABASE_URL=postgres://${TMTERMINAL_DATABASE_USER}:${TMTERMINAL_DATABASE_PASSWORD}@${TMTERMINAL_DATABASE_HOST}:${TMTERMINAL_DATABASE_PORT}/${TMTERMINAL_DATABASE_NAME}

# Real-PostgreSQL integration lane. Runtime-provided rather than resolved: the
# Compose test profile supplies its container-network form, and an operator or
# cloud agent supplies a loopback form. The suite skips when it is unset.
# @sensitive @optional
TMTERMINAL_TEST_DATABASE_URL=


# --- USPTO Open Data Portal (Trademark Terminal-owned) --------------------
# One ODP key serves both lifecycles — the portal issues a single key per
# account — so it is stored in both vaults with a cross-reference in each note.

# @sensitive @required
TMTERMINAL_USPTO_API_KEY=if(eq($VARLOCK_ENV, test), uspto-test-api-key, if(eq($VARLOCK_ENV, production), op(production, "op://Production/USPTO ODP API - TMTerminal/credential"), op(development, "op://Development/USPTO ODP API - TMTerminal/credential")))

# Ceiling for a single ODP request, and the basis for the worker's staging
# sweep age. Must be a positive integer.
# @public @type=number
TMTERMINAL_USPTO_REQUEST_TIMEOUT_MS=900000
