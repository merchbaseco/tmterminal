{
  "name": "@tmterminal/http-client",
  "version": "3.0.0",
  "description": "Typed HTTP client for the Trademark Terminal API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merchbaseco/tmterminal.git",
    "directory": "packages/http-client"
  },
  "homepage": "https://github.com/merchbaseco/tmterminal#readme",
  "bugs": "https://github.com/merchbaseco/tmterminal/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0"
  },
  "devDependencies": {
    "tsdown": "0.22.8"
  }
}
