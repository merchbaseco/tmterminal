{
  "name": "@tmterminal/cli",
  "version": "3.0.0",
  "description": "Command-line access to Trademark Terminal search, matching, and service status",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merchbaseco/tmterminal.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/merchbaseco/tmterminal#readme",
  "bugs": "https://github.com/merchbaseco/tmterminal/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "tt": "dist/tt.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/tt.ts --outdir dist --target bun",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@tmterminal/http-client": "workspace:*",
    "commander": "15.0.0"
  }
}
