{
  "name": "tmturtle",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api-keys:create": "docker compose exec api bun run --cwd apps/server api-keys:create",
    "build": "bun run --filter '*' build",
    "check": "bun run typecheck && bun run test",
    "compose": "./scripts/compose",
    "compose:down": "./scripts/compose down",
    "compose:smoke": "./scripts/compose-smoke",
    "compose:up": "./scripts/compose up --build --detach --wait",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "docs:list": "docs-list",
    "fixtures:verify": "bun scripts/uspto-fixtures.ts",
    "test": "bun test apps/server/test/unit packages/http-client/test packages/cli/test && bun test apps/web/test",
    "test:fixtures": "bun test scripts/uspto-fixtures.test.ts",
    "test:integration": "bun test apps/server/test/integration",
    "test:integration:compose": "./scripts/test-integration-compose",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
