{
  "name": "tmturtle",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api-keys:create": "docker compose exec api bun run --cwd apps/server api-keys:create",
    "build": "bun run --cwd packages/http-client build && bun run --cwd apps/server build && bun run --cwd apps/web build && bun run --cwd packages/cli build",
    "check": "bun run typecheck && bun run test",
    "compose": "./scripts/compose",
    "compose:down": "./scripts/compose down",
    "compose:smoke": "./scripts/compose-smoke",
    "compose:up": "./scripts/compose up --build --detach --wait",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:migrate": "bun run --cwd apps/server db:migrate",
    "dev": "./scripts/dev",
    "docs:list": "docs-list",
    "fixtures:verify": "bun scripts/uspto-fixtures.ts",
    "lint": "ultracite check",
    "lint:changed": "ultracite check --changed --since=${LINT_BASE:-origin/main}",
    "lint:fix": "ultracite fix",
    "test": "bun test apps/server/test/unit packages/http-client/test packages/cli/test scripts/dev-contract.test.ts && bun test apps/web/test && ./scripts/deployment-contract.test",
    "test:fixtures": "bun test scripts/uspto-fixtures.test.ts",
    "test:integration": "bun test apps/server/test/integration",
    "test:integration:compose": "./scripts/test-integration-compose",
    "typecheck": "bun run --cwd packages/http-client build && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2",
    "ultracite": "7.9.4"
  }
}
