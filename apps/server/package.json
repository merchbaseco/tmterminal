{
  "name": "@tmterminal/core-server",
  "private": true,
  "type": "module",
  "scripts": {
    "access:inventory": "bun run src/access-inventory.ts",
    "build": "bun build src/server.ts src/worker.ts src/db/migrate.ts --outdir dist --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "source:repair": "bun run src/source-repair.ts",
    "start": "bun run src/server.ts",
    "worker": "bun run src/worker.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.11.5",
    "@merchbaseco/access": "0.2.1",
    "@trpc/server": "11.18.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "postgres": "3.4.9",
    "unzipper": "0.12.5",
    "xml-flow": "1.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/xml-flow": "1.0.4",
    "drizzle-kit": "0.31.10"
  }
}
