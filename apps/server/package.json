{
  "name": "@tmturtle/core-server",
  "private": true,
  "type": "module",
  "scripts": {
    "api-keys:create": "bun run src/api-keys-create.ts",
    "build": "bun build src/server.ts src/worker.ts src/db/migrate.ts src/tracer-materialize.ts --outdir dist --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "start": "bun run src/server.ts",
    "tracer:materialize": "bun run src/tracer-materialize.ts",
    "worker": "bun run src/worker.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.11.5",
    "@trpc/server": "11.18.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
