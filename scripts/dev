#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"

# Values come from the committed .env.schema, resolved through 1Password by
# `varlock run`. There is no .env step: the development lifecycle already
# targets the production database over Tailscale, so nothing is rewritten here.
# The two overrides below are exported BEFORE the re-exec so they win over the
# schema (process env has the highest precedence in varlock).
if [ -z "${TMTERMINAL_DEV_ENV_READY:-}" ]; then
  web_port="$(dev-port 0)"
  api_port="$(dev-port 1)"
  TMTERMINAL_CLERK_AUTHORIZED_PARTIES="http://127.0.0.1:${web_port}"
  TMTERMINAL_PORT="$api_port"
  TMTERMINAL_API_PORT="$api_port"
  TMTERMINAL_WEB_PORT="$web_port"
  TMTERMINAL_DEV_ENV_READY=1
  export TMTERMINAL_CLERK_AUTHORIZED_PARTIES TMTERMINAL_PORT TMTERMINAL_API_PORT
  export TMTERMINAL_WEB_PORT TMTERMINAL_DEV_ENV_READY
  exec bunx varlock run -- "$0" "$@"
fi

web_port="$TMTERMINAL_WEB_PORT"
api_port="$TMTERMINAL_API_PORT"

printf 'Using the production database; mutations are real. Worker and migrations are disabled.\n'
printf 'Website: http://127.0.0.1:%s\nAPI: http://127.0.0.1:%s\n' "$web_port" "$api_port"

bun apps/server/src/server.ts &
api_pid=$!
apps/web/node_modules/.bin/vite apps/web --port "$web_port" &
web_pid=$!

cleanup() {
  kill "$api_pid" "$web_pid" 2>/dev/null || true
  wait "$api_pid" "$web_pid" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

while :; do
  jobs -p >/dev/null
  if ! kill -0 "$api_pid" 2>/dev/null; then
    if wait "$api_pid"; then
      status=1
    else
      status=$?
    fi
    break
  fi
  if ! kill -0 "$web_pid" 2>/dev/null; then
    if wait "$web_pid"; then
      status=1
    else
      status=$?
    fi
    break
  fi
  sleep 1
done
exit "$status"
