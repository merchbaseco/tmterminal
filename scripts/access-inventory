#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"

docker compose --project-name tmterminal --env-file .env exec -T database sh -c \
  'PGOPTIONS="-c default_transaction_read_only=on" exec psql \
    --set=ON_ERROR_STOP=1 \
    --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --no-align --tuples-only' <<'SQL'
begin read only;
select json_build_object(
  'accounts', (select count(*) from account),
  'legacyIdentities', (select count(*) from clerk_identity),
  'legacyKeys', (select count(*) from api_key),
  'activeLegacyKeys', (select count(*) from api_key where revoked_at is null)
);
select json_build_object(
  'mappingColumnPresent', exists(
    select from information_schema.columns
    where table_schema = 'public'
      and table_name = 'account'
      and column_name = 'merchbase_user_id'
  ),
  'projectionTablePresent', to_regclass('public.access_projection') is not null
);
select exists(
  select from information_schema.columns
  where table_schema = 'public'
    and table_name = 'account'
    and column_name = 'merchbase_user_id'
) as mapping_column_present \gset
\if :mapping_column_present
select json_build_object(
  'mappedAccounts', (
    select count(*) from account where merchbase_user_id is not null
  )
);
\else
select json_build_object('mappedAccounts', 0);
\endif
select (to_regclass('public.access_projection') is not null) as projection_table_present \gset
\if :projection_table_present
select json_build_object(
  'activeProjections', count(*) filter (
    where merchbase_user_id is not null and access is not null
  ),
  'projectionTombstones', count(*) filter (
    where merchbase_user_id is null and access is null
  )
) from access_projection;
\else
select json_build_object('activeProjections', 0, 'projectionTombstones', 0);
\endif
commit;
SQL
