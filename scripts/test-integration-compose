#!/bin/sh
set -eu

# The integration lane is hermetic: VARLOCK_ENV=test resolves every schema item
# to a fake-but-shaped literal with no 1Password access, and the compose test
# profile supplies the container-network TMTERMINAL_TEST_DATABASE_URL itself.
project="${COMPOSE_PROJECT_NAME:-tmterminal-test-$$}"
export VARLOCK_ENV=test

cleanup() {
  bunx varlock run -- docker compose --project-name "$project" --profile test down \
    --volumes --remove-orphans
}

trap cleanup EXIT

bunx varlock run -- docker compose --project-name "$project" --profile test up \
  --build \
  --abort-on-container-exit \
  --exit-code-from integration-test \
  integration-test
