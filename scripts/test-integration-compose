#!/bin/sh
set -eu

project="${COMPOSE_PROJECT_NAME:-tmterminal-test-$$}"
export DATABASE_URL="${DATABASE_URL:-postgres://unused:unused@database:5432/unused}"
export CLERK_AUTHORIZED_PARTIES="${CLERK_AUTHORIZED_PARTIES:-http://127.0.0.1:3000}"
export CLERK_SECRET_KEY="${CLERK_SECRET_KEY:-unused-test-key}"
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-unused}"
export TMTERMINAL_API_PORT="${TMTERMINAL_API_PORT:-0}"
export TMTERMINAL_WEB_PORT="${TMTERMINAL_WEB_PORT:-0}"
export USPTO_API_KEY="${USPTO_API_KEY:-unused-test-key}"
export VITE_CLERK_PUBLISHABLE_KEY="${VITE_CLERK_PUBLISHABLE_KEY:-unused-test-key}"

cleanup() {
  docker compose --project-name "$project" --profile test down --volumes --remove-orphans
}

trap cleanup EXIT

docker compose --project-name "$project" --profile test up \
  --build \
  --abort-on-container-exit \
  --exit-code-from integration-test \
  integration-test
