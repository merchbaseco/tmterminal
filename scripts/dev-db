#!/usr/bin/env bash
# Shared local-development database: loopback Postgres, migrate, fabricated seed.
# Used by `bun run dev` and Cloud `.cursor/start.sh`. Never talks to USPTO.
set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"

export TMTERMINAL_DATABASE_HOST="${TMTERMINAL_DATABASE_HOST:-127.0.0.1}"

if [ -x /usr/lib/postgresql/16/bin/pg_ctl ]; then
  # shellcheck source=.cursor/postgres-lib.sh
  . "$root/.cursor/postgres-lib.sh"
  pg_start
  pg_ensure_databases
elif command -v docker >/dev/null 2>&1; then
  bunx varlock run -- docker compose --project-name tmterminal-dev up --detach --wait database
else
  echo "Need local PostgreSQL on 127.0.0.1:5437 (PostgreSQL 16 or Docker)." >&2
  exit 1
fi

bun run db:migrate

echo "[dev-db] Seeding synthetic development data."
if ! bun run db:seed:dev; then
  echo "[dev-db] Skipping synthetic dev data (seed failed)." >&2
fi
