#!/bin/sh
set -eu

if [ -z "${TMTURTLE_WEB_PORT:-}" ] || [ -z "${TMTURTLE_API_PORT:-}" ]; then
  TMTURTLE_WEB_PORT="${TMTURTLE_WEB_PORT:-$(dev-port 0)}"
  TMTURTLE_API_PORT="${TMTURTLE_API_PORT:-$(dev-port 1)}"
fi

export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-tmturtle-${TMTURTLE_WEB_PORT}}"
export CLERK_AUTHORIZED_PARTIES="${CLERK_AUTHORIZED_PARTIES:-http://127.0.0.1:${TMTURTLE_WEB_PORT}}"
export TMTURTLE_REVISION="${TMTURTLE_REVISION:-development-${COMPOSE_PROJECT_NAME}}"
export TMTURTLE_WEB_PORT TMTURTLE_API_PORT CLERK_AUTHORIZED_PARTIES TMTURTLE_REVISION

exec docker compose "$@"
