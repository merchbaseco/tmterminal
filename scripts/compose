#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"

# Workstation Compose stack. Values resolve from .env.schema through
# `varlock run`; the per-checkout port allocations are exported first so they
# win over the schema's defaults.
if [ -z "${TMTERMINAL_COMPOSE_ENV_READY:-}" ]; then
  if [ -z "${TMTERMINAL_WEB_PORT:-}" ] || [ -z "${TMTERMINAL_API_PORT:-}" ]; then
    TMTERMINAL_WEB_PORT="${TMTERMINAL_WEB_PORT:-$(dev-port 0)}"
    TMTERMINAL_API_PORT="${TMTERMINAL_API_PORT:-$(dev-port 1)}"
  fi
  TMTERMINAL_DATABASE_PUBLISHED_PORT="${TMTERMINAL_DATABASE_PUBLISHED_PORT:-$(dev-port 2)}"

  COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-tmterminal-${TMTERMINAL_WEB_PORT}}"
  TMTERMINAL_CLERK_AUTHORIZED_PARTIES="${TMTERMINAL_CLERK_AUTHORIZED_PARTIES:-http://127.0.0.1:${TMTERMINAL_WEB_PORT}}"
  TMTERMINAL_REVISION="${TMTERMINAL_REVISION:-development-${COMPOSE_PROJECT_NAME}}"
  TMTERMINAL_COMPOSE_ENV_READY=1
  export COMPOSE_PROJECT_NAME TMTERMINAL_CLERK_AUTHORIZED_PARTIES TMTERMINAL_REVISION
  export TMTERMINAL_WEB_PORT TMTERMINAL_API_PORT TMTERMINAL_DATABASE_PUBLISHED_PORT
  export TMTERMINAL_COMPOSE_ENV_READY
  exec bunx varlock run -- "$0" "$@"
fi

# Inside the varlock child: the @internal install credentials were stripped on
# the way in, so re-resolve them here for the image build's BuildKit secrets.
# shellcheck source=scripts/install-tokens
. "$root/scripts/install-tokens"

exec docker compose "$@"
