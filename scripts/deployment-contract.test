#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
temporary_directory="$(mktemp -d)"
trap 'rm -rf "$temporary_directory"' EXIT

# --- Exact-revision gate -------------------------------------------------

repository="$temporary_directory/repository"
git init --quiet "$repository"
git -C "$repository" config user.email test@example.com
git -C "$repository" config user.name Test
printf 'tracked\n' > "$repository/tracked"
git -C "$repository" add tracked
git -C "$repository" commit --quiet --message initial
git -C "$repository" branch --move main
git -C "$repository" update-ref refs/remotes/origin/main "$(git -C "$repository" rev-parse HEAD)"

expected_revision="$(git -C "$repository" rev-parse HEAD)"
revision="$(cd "$repository" && "$root/scripts/deployment-revision" "$expected_revision")"
test "$revision" = "$(git -C "$repository" rev-parse HEAD)"
if (cd "$repository" && "$root/scripts/deployment-revision" 0000000000000000000000000000000000000000) >/dev/null 2>&1; then
  echo "deployment revision accepted HEAD different from the expected revision" >&2
  exit 1
fi

touch "$repository/untracked"
if (cd "$repository" && "$root/scripts/deployment-revision" "$expected_revision") >/dev/null 2>&1; then
  echo "deployment revision accepted an untracked file" >&2
  exit 1
fi
rm "$repository/untracked"

printf 'dirty\n' >> "$repository/tracked"
if (cd "$repository" && "$root/scripts/deployment-revision" "$expected_revision") >/dev/null 2>&1; then
  echo "deployment revision accepted a dirty tracked file" >&2
  exit 1
fi
git -C "$repository" add tracked
git -C "$repository" commit --quiet --message next
if (cd "$repository" && "$root/scripts/deployment-revision" "$(git -C "$repository" rev-parse HEAD)") >/dev/null 2>&1; then
  echo "deployment revision accepted HEAD different from origin/main" >&2
  exit 1
fi

# --- Compose wrapper: per-checkout ports, revision, and varlock delivery --

fake_bin="$temporary_directory/bin"
mkdir "$fake_bin"
# `bunx varlock run [flags] -- <cmd>` is transparent here: the wrapper's
# contract is that it delivers through varlock and never through --env-file.
# `varlock printenv` is answered inline so the install-token helper resolves.
printf '%s\n' '#!/bin/sh' \
  'test "$1" = "varlock"' \
  'if test "$2" = "printenv"; then printf '\''resolved-%s\n'\'' "$3"; exit 0; fi' \
  'test "$2" = "run"' \
  'shift 2' \
  'while test "$#" -gt 0 && test "$1" != "--"; do shift; done' \
  'shift' \
  'exec "$@"' > "$fake_bin/bunx"
chmod +x "$fake_bin/bunx"
printf '%s\n' '#!/bin/sh' 'printf '\''%s|%s|%s|%s\n'\'' "$COMPOSE_PROJECT_NAME" "$TMTERMINAL_REVISION" "$TMTERMINAL_DATABASE_PUBLISHED_PORT" "$*"' > "$fake_bin/docker"
chmod +x "$fake_bin/docker"
printf '%s\n' '#!/bin/sh' 'test "$1" = 2' 'printf '\''4102\n'\''' > "$fake_bin/dev-port"
chmod +x "$fake_bin/dev-port"

compose_revision() (
  explicit_revision="${3:-}"
  unset TMTERMINAL_CLERK_AUTHORIZED_PARTIES COMPOSE_PROJECT_NAME TMTERMINAL_REVISION
  unset TMTERMINAL_DATABASE_PUBLISHED_PORT
  if test -n "$explicit_revision"; then
    export TMTERMINAL_REVISION="$explicit_revision"
  fi
  PATH="$fake_bin:$PATH" TMTERMINAL_WEB_PORT="$1" TMTERMINAL_API_PORT="$2" "$root/scripts/compose" config
)

test "$(compose_revision 4100 4101)" = "tmterminal-4100|development-tmterminal-4100|4102|compose config"
test "$(compose_revision 4200 4201)" = "tmterminal-4200|development-tmterminal-4200|4102|compose config"
test "$(compose_revision 4100 4101 production-sha)" = "tmterminal-4100|production-sha|4102|compose config"

if grep -qF -- '--env-file' "$root/scripts/compose"; then
  echo "compose wrapper still delivers through a plaintext env file" >&2
  exit 1
fi

# `varlock run` strips @internal names from the child environment even when they
# are already exported, so every entry point that builds an image must
# re-resolve the install credentials INSIDE the varlock child. Without this the
# BuildKit `required=true` secret mounts arrive empty and the build fails.
grep -qF 'TMTERMINAL_RESOLVE_INSTALL_TOKENS=true' "$root/scripts/install-tokens"
# The nested resolution must start clean: varlock's run markers would make it
# reuse the parent's blanked values, and an inherited empty credential would
# outrank the schema.
grep -qF 'VARLOCK_ENV=development' "$root/scripts/install-tokens"
for cleared in __VARLOCK_RUN __VARLOCK_ENV MERCHBASE_GITHUB_NPM_TOKEN MERCHBASE_HUGEICONS_LICENSE_KEY; do
  grep -qF -- "-u $cleared" "$root/scripts/install-tokens"
done
for build_entry_point in scripts/compose scripts/test-integration-compose; do
  grep -qF 'exec bunx varlock run --include-internal -- "$0" "$@"' "$root/$build_entry_point"
  grep -qF '. "$root/scripts/install-tokens"' "$root/$build_entry_point"
  install_line="$(grep -nF '. "$root/scripts/install-tokens"' "$root/$build_entry_point" | cut -d: -f1)"
  reexec_line="$(grep -nF 'exec bunx varlock run --include-internal -- "$0" "$@"' "$root/$build_entry_point" | cut -d: -f1)"
  test "$reexec_line" -lt "$install_line"
done

# --- Source import pins the checkout revision and refuses a live worker ---

printf '%s\n' '#!/bin/sh' \
  'if test "$*" = "compose ps --all --quiet worker"; then test -n "${FAKE_WORKER_STATE:-}" && printf '\''worker-id\n'\''; exit 0; fi' \
  'if test "$1" = "inspect"; then printf '\''%s\n'\'' "$FAKE_WORKER_STATE"; exit 0; fi' \
  'printf '\''%s|%s\n'\'' "$TMTERMINAL_REVISION" "$*"' > "$fake_bin/docker"
chmod +x "$fake_bin/docker"
touch "$repository/apc260714.zip"
import_revision="$(git -C "$repository" rev-parse HEAD)"
import_call="$({
  cd "$repository"
  PATH="$fake_bin:$PATH" "$root/scripts/source-import" TRTDXFAP "$repository/apc260714.zip"
})"
case "$import_call" in
  "$import_revision|compose run --rm --no-deps --volume "*) ;;
  *)
    echo "source import did not pin the checkout revision" >&2
    exit 1
    ;;
esac
if (
  cd "$repository"
  PATH="$fake_bin:$PATH" FAKE_WORKER_STATE=restarting \
    "$root/scripts/source-import" TRTDXFAP "$repository/apc260714.zip"
) >/dev/null 2>&1; then
  echo "source import accepted a restarting worker" >&2
  exit 1
fi

# --- Deploy script: refusals, lifecycle pin, and step ordering ------------

deploy_script="$root/scripts/deploy-with-varlock.ts"

# A checkout .env silently overrides the schema, so the deploy must refuse.
grep -qF "existsSync('.env')" "$deploy_script" || grep -qF 'existsSync(".env")' "$deploy_script"
# The production lifecycle is pinned by the script, never inherited.
grep -qF 'VARLOCK_ENV: "production"' "$deploy_script"
# The deploy-agent role slot, with the operator `op run` fallback.
grep -qF 'DEPLOY_AGENT_PRODUCTION_OP_TOKEN' "$deploy_script"
grep -qF 'op://Automation/Production Varlock - Mac Mini/credential' "$deploy_script"
# Install credentials belong to the development lifecycle.
grep -qF 'VARLOCK_ENV: "development"' "$deploy_script"
grep -qF 'TMTERMINAL_RESOLVE_INSTALL_TOKENS' "$deploy_script"
# The centralized-auth cleanup is complete; any other state must refuse.
grep -qF 'cleanupState !== "final"' "$deploy_script"

line_of() {
  grep -nF "$1" "$deploy_script" | head -n 1 | cut -d: -f1
}
worker_stop_line="$(line_of 'Stopping the API and worker')"
migration_line="$(line_of 'Applying migrations')"
invariant_line="$(line_of 'Post-migration invariant check')"
stack_start_line="$(line_of 'Starting the stack')"
smoke_line="$(line_of 'Deployment smoke')"
verify_line="$(line_of 'verify-deployed-secrets.ts')"
test -n "$worker_stop_line"
test -n "$migration_line"
test -n "$invariant_line"
test -n "$stack_start_line"
test -n "$smoke_line"
test -n "$verify_line"
test "$worker_stop_line" -lt "$migration_line"
test "$migration_line" -lt "$invariant_line"
test "$invariant_line" -lt "$stack_start_line"
test "$stack_start_line" -lt "$smoke_line"
test "$smoke_line" -lt "$verify_line"

grep -qF -- '--set=ON_ERROR_STOP=1' "$root/scripts/auth-cleanup-inventory"

# The deploy-time guard must not demand items that are deliberately composed
# into another value or read by only one service.
verify_script="$root/scripts/verify-deployed-secrets.ts"
grep -qF 'notDeliveredToApi' "$verify_script"
grep -qF '"TMTERMINAL_DATABASE_PASSWORD"' "$verify_script"
grep -qF 'requiredOnWorker' "$verify_script"

# --- Deploy workflow: manual only, one secret, both bootstrap slots -------

deployment_workflow="$root/.github/workflows/deploy.yml"
grep -qF 'name: Deploy Stack' "$deployment_workflow"
grep -qF 'DEPLOY_AGENT_PRODUCTION_OP_TOKEN: ${{ secrets.GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN }}' "$deployment_workflow"
grep -qF 'CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN: ${{ secrets.GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN }}' "$deployment_workflow"
grep -qF 'run: bun run deploy' "$deployment_workflow"
# The exact-revision gate requires HEAD to equal origin/main, so the sync step
# must advance the remote-tracking ref — fetching a bare SHA does not.
grep -qF 'git fetch origin main' "$deployment_workflow"
if grep -qF 'git fetch --depth=1 origin "${GITHUB_SHA}"' "$deployment_workflow"; then
  echo "the deploy sync fetches a bare SHA and leaves origin/main behind" >&2
  exit 1
fi
if grep -qF '  push:' "$deployment_workflow"; then
  echo "the deploy workflow still deploys on main push" >&2
  exit 1
fi
if grep -qE 'secrets\.(HUGEICONS_LICENSE_KEY|MERCHBASE_GITHUB_NPM_TOKEN)' "$deployment_workflow"; then
  echo "the deploy workflow still injects install credentials as platform secrets" >&2
  exit 1
fi
if grep -qF -- '--env-file' "$deployment_workflow"; then
  echo "the deploy workflow still delivers through a plaintext env file" >&2
  exit 1
fi

# Quality resolves install credentials through the schema, not github.token.
quality_workflow="$root/.github/workflows/quality.yml"
grep -qF 'CURSOR_CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN: ${{ secrets.GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN }}' "$quality_workflow"
grep -qF 'timeout-minutes: 5' "$quality_workflow"
if grep -qF '${{ github.token }}' "$quality_workflow"; then
  echo "Quality still installs private packages with the ambient github.token" >&2
  exit 1
fi

# --- Deployment smoke keeps its worker-heartbeat gate ---------------------

deployment_smoke="$root/scripts/deployment-smoke"
grep -qF 'current_error is null and last_heartbeat_at' "$deployment_smoke"
if grep -qF 'source_lane' "$deployment_smoke"; then
  echo "deployment smoke still depends on the retired source lane" >&2
  exit 1
fi
if grep -qF -- '--env-file' "$deployment_smoke"; then
  echo "deployment smoke still delivers through a plaintext env file" >&2
  exit 1
fi

echo "Deployment shell contracts passed"
