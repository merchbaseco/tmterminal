#!/bin/sh
set -eu

candidate_sha=${1:?Usage: prd77-premerge-cutover <candidate-sha> <main-checkout> <master-env>}
main_checkout=${2:?Usage: prd77-premerge-cutover <candidate-sha> <main-checkout> <master-env>}
master_env=${3:?Usage: prd77-premerge-cutover <candidate-sha> <main-checkout> <master-env>}
candidate_checkout="${main_checkout}-prd77-cutover"

test "${#candidate_sha}" -eq 40
case "$candidate_sha" in
  *[!0-9a-f]*) exit 2 ;;
esac
test -d "$main_checkout"
test -f "$master_env"
git -C "$main_checkout" fetch --prune origin
git -C "$main_checkout" cat-file -e "$candidate_sha^{commit}"
test ! -e "$candidate_checkout"
git -C "$main_checkout" worktree add --detach "$candidate_checkout" "$candidate_sha"
test "$(git -C "$candidate_checkout" rev-parse HEAD)" = "$candidate_sha"
test -z "$(git -C "$candidate_checkout" status --porcelain)"
install -m 600 "$master_env" "$candidate_checkout/.env"
TMTURTLE_WEB_PORT=$(sed -n 's/^TMTURTLE_WEB_PORT=//p' "$master_env")
TMTURTLE_API_PORT=$(sed -n 's/^TMTURTLE_API_PORT=//p' "$master_env")
CLERK_AUTHORIZED_PARTIES=$(sed -n 's/^CLERK_AUTHORIZED_PARTIES=//p' "$master_env")
test -n "$TMTURTLE_WEB_PORT"
test -n "$TMTURTLE_API_PORT"
test -n "$CLERK_AUTHORIZED_PARTIES"

cd "$candidate_checkout"
export CLERK_AUTHORIZED_PARTIES COMPOSE_PROJECT_NAME=tmturtle TMTURTLE_API_PORT
export TMTURTLE_REVISION="$candidate_sha" TMTURTLE_WEB_PORT
test "$(git rev-parse HEAD)" = "$TMTURTLE_REVISION"
./scripts/compose build
./scripts/compose stop worker
COMPOSE_PROJECT_NAME=tmturtle ./scripts/full-rebuild
