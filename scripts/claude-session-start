#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"

# There is no .env step — the committed .env.schema is the whole environment
# contract. The install credentials are @internal schema items, so they are
# fetched explicitly under the install switch.
if [ ! -x apps/web/node_modules/.bin/vite ]; then
  # shellcheck source=scripts/install-tokens
  . "$root/scripts/install-tokens"
  bun install --frozen-lockfile >&2
fi

dev-port --claude-launch dev ./scripts/dev
