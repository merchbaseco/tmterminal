#!/bin/sh
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$root"

restart_worker() {
  ./scripts/compose start worker
}

./scripts/compose stop worker
trap restart_worker EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
./scripts/compose run --rm --no-deps -e TMTURTLE_OFFLINE_REBUILD=1 worker \
  bun run --cwd apps/server sync:ops -- full-rebuild --confirm-offline-rebuild
